{
  "name": "mednexus-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MedNexus API rewritten for Cloudflare Workers + D1 (SQLite) + Workers Assets (SPA)",
  "main": "src/worker.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate:generate": "drizzle-kit generate",
    "migrate:apply:local": "npx wrangler d1 migrations apply mednexus-db --local",
    "migrate:apply": "npx wrangler d1 migrations apply mednexus-db",
    "db:create": "npx wrangler d1 create mednexus-db",
    "seed:library": "node scripts/seed-library.mjs",
    "build:frontend": "cd new-frontend && npm ci && npm run build && node ../scripts/copy-frontend.mjs",
    "build": "npm run build:frontend && vite build",
    "dev": "npm run build:frontend && vite dev",
    "preview": "npm run build:frontend && vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:skip-ngrok": "SKIP_NGROK=1 node scripts/tunnel.mjs",
    "tunnel:local-db": "SKIP_NGROK=1 SKIP_DB_TUNNEL=1 node scripts/tunnel.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "deploy:frontend": "cd new-frontend && npm run build && echo 'Deploy new-frontend/dist to Cloudflare Pages'",
    "mine": "node scripts/mine.mjs",
    "failures:export": "node scripts/export-failures.mjs",
    "failures:export:remote": "node scripts/export-failures.mjs --remote"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@libsql/client": "^0.17.4",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "tsx": "^4.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@cloudflare/workers-types": "^5.20260718.1",
    "drizzle-kit": "^0.28.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "wrangler": "^4.113.0"
  }
}
